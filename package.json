{
  "name": "@crystal-path-infinity/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/mobile",
    "packages/game-core",
    "packages/server-core"
  ],
  "engines": {
    "node": ">=22.23.4 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @crystal-path-infinity/mobile",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspace @crystal-path-infinity/mobile",
    "build:staging": "npm run build:staging --workspace @crystal-path-infinity/mobile",
    "build:production": "npm run build:production --workspace @crystal-path-infinity/mobile",
    "preview": "npm run preview --workspace @crystal-path-infinity/mobile",
    "native:generate": "node --experimental-strip-types apps/mobile/scripts/generate-native.mjs",
    "planning:check": "python3 scripts/validate_plan.py && python3 -m unittest discover -s scripts -p 'test_*.py'",
    "lint": "eslint apps/mobile packages/game-core packages/server-core .github/scripts supabase/functions eslint.config.mjs prettier.config.mjs --max-warnings 0",
    "format:check": "prettier --check package.json eslint.config.mjs prettier.config.mjs \"apps/mobile/**/*.{ts,tsx,mjs,css,html,json}\" \"packages/game-core/**/*.{ts,mjs,json}\" \".github/scripts/**/*.mjs\" \"packages/server-core/**/*.{ts,mjs,json}\" \"supabase/functions/**/*.{ts,json}\"",
    "format": "prettier --write package.json eslint.config.mjs prettier.config.mjs \"apps/mobile/**/*.{ts,tsx,mjs,css,html,json}\" \"packages/game-core/**/*.{ts,mjs,json}\" \".github/scripts/**/*.mjs\" \"packages/server-core/**/*.{ts,mjs,json}\" \"supabase/functions/**/*.{ts,json}\""
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.0.16",
    "vitest": "4.1.2"
  }
}
