# Private SERVER configuration only. Never copy this file into apps/mobile or use VITE_ for these values.
CPI_LIVE_ENABLED=false
CPI_ENVIRONMENT=staging
CPI_PROJECT_REF=REPLACE_ISOLATED_PROJECT_REF
SUPABASE_URL=https://REPLACE_ISOLATED_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_ONLY_KEY
# Session pooler on port 5432, or the verified project's direct PostgreSQL host. No URL query parameters.
# Use the cpi_runtime login, NOT postgres. Keep the administrator connection out of the deployed function.
CPI_DATABASE_URL=REPLACE_TLS_POSTGRES_CONNECTION
# When the database uses a private CA, use the dashboard certificate as PEM with escaped newlines.
CPI_DATABASE_CA=
CPI_RUNTIME_DB_PASSWORD=REPLACE_LOCAL_BOOTSTRAP_PASSWORD
CPI_PRIVATE_PEPPER=REPLACE_32_BYTE_HEX
CPI_ENCRYPTION_KEY=REPLACE_DIFFERENT_32_BYTE_HEX
CPI_GATEWAY_KEY=REPLACE_DIFFERENT_32_BYTE_HEX
CPI_WORKER_KEY=REPLACE_DIFFERENT_32_BYTE_HEX
CPI_ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost,https://REPLACE_GAME_HOST
CPI_RESEND_API_KEY=REPLACE_SENDING_KEY
# Staging sender. Use the verified production sender in the separate production configuration.
CPI_MAIL_FROM=login@auth.kolequant.xyz
# Exact age is screened transiently. This is NOT age assurance or a parental-verification service.
# Countries requiring an unconnected assurance/guardian method stay closed for accounts; guest play remains available.
CPI_ACCOUNT_POLICY='{"status":"unreviewed","reviewReference":"REPLACE_REVIEW_REFERENCE","version":"cpi-account-2026-11-v1","countries":{}}'
CPI_REWARDS_ENABLED=false
CPI_PURCHASES_ENABLED=false
# Set only after real products exist; use the generated catalogue as the starting point.
CPI_COMMERCE_PRODUCTS='{"status":"unconfirmed","products":[]}'
# Staging requires exactly two approved account emails.
CPI_STAGING_TEST_EMAILS=first@example.invalid,second@example.invalid
CPI_GOOGLE_CLIENT_EMAIL=REPLACE_SERVICE_ACCOUNT
CPI_GOOGLE_PRIVATE_KEY=REPLACE_PRIVATE_KEY_WITH_ESCAPED_NEWLINES
CPI_APPLE_ISSUER_ID=REPLACE_APP_STORE_CONNECT_ISSUER_ID
CPI_APPLE_KEY_ID=REPLACE_IN_APP_PURCHASE_KEY_ID
CPI_APPLE_PRIVATE_KEY=REPLACE_P8_KEY_WITH_ESCAPED_NEWLINES
# Required for iOS Sandbox purchases on staging. Use an independent 32-byte hex key.
CPI_APPLE_SANDBOX_VERIFIER_KEY=REPLACE_STAGE_VERIFIER_32_BYTE_HEX
