# Staging placeholders only. Copy to .env.staging.local if needed.
# Select the build identity with the project's environment build command.
# CPI_APP_ENV selects Capacitor; Capacitor does not load this example file.
# VITE_* values become public client assets: never place secrets here.
# Reserved for later backend work; the scaffold does not connect to this URL.
VITE_API_BASE_URL=

# CPI-018: not active until the trusted jurisdiction/guardian gate is deployed.
# HTTPS endpoint must enforce eligibility before any OTP email operation.
# This is public client configuration, NEVER a service-role key.
VITE_ACCOUNT_API_BASE_URL=
