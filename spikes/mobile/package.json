{
  "name": "@crystal-path-infinity/mobile-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "probe": "node --experimental-strip-types server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "measure": "node --experimental-strip-types scripts/measure-probe.mjs",
    "build": "npm run typecheck && vite build",
    "native:generate": "node scripts/generate-native.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.2"
  }
}
